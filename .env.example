# Copy to .env if you want overrides. Never commit .env. Leave secrets blank.

# Prose only. deterministic never opens a socket. ollama is optional and local.
LLM_BACKEND=deterministic
LLM_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434

# Asana is required for the hosted demo. Leave the secrets blank in git.
# CI stays on offline and does not call the API. The demo raises until
# ASANA_BACKEND=live and both values below are set.
ASANA_BACKEND=offline
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=

# Salesforce Developer Edition is required for the hosted demo. Leave these blank.
# The demo raises until SALESFORCE_BACKEND=live and every SF_* value is set.
SALESFORCE_BACKEND=offline
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# Tableau Public is required for the hosted demo. After you publish, set this
# to the viz URL. It must be https://public.tableau.com/...
TABLEAU_PUBLIC_URL=

# Hosted Postgres for the public demo. Neon free plan, Project -> Connect.
# Leave this blank in git. The URL contains a password.
# DATABASE_URL is accepted as an alias. Localhost is refused by the public
# loader unless CARE_OPS_ALLOW_LOCAL=1 (CI or a laptop SQL check).
CARE_OPS_PG_DSN=
# CARE_OPS_ALLOW_LOCAL=
# CARE_OPS_ALLOW_SYNTHETIC_UPLOAD=
CARE_OPS_OUT=out
